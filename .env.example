# FlyEsports Environment Configuration Template
# Copy this file to .env and fill in your values

# =================================
# Application Settings
# =================================
APP_NAME="FlyEsports API"
VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# =================================
# Server Settings
# =================================
HOST=0.0.0.0
PORT=8000

# =================================
# CORS Settings
# =================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =================================
# Database Settings
# =================================
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://flyesports:${POSTGRES_PASSWORD}@localhost:5432/flyesports
DATABASE_ECHO=false

# =================================
# Redis Settings
# =================================
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# =================================
# JWT Settings
# =================================
JWT_SECRET_KEY=your-very-long-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# =================================
# Security Settings
# =================================
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# =================================
# Riot Games API Settings
# =================================
RIOT_API_KEY=your_riot_api_key_here
RIOT_API_BASE_URL=https://api.riotgames.com

# =================================
# Celery Settings
# =================================
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@localhost:6379/1

# =================================
# Logging Settings
# =================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =================================
# Frontend Settings (for docker-compose)
# =================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=FlyEsports
VITE_APP_ENV=development