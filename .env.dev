# FlyEsports Development Environment Configuration
# This file is used for local development

# =================================
# Application Settings
# =================================
APP_NAME="FlyEsports API"
VERSION="0.1.0"
DEBUG=true
ENVIRONMENT=development

# =================================
# Server Settings
# =================================
HOST=0.0.0.0
PORT=8000

# =================================
# CORS Settings
# =================================
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =================================
# Database Settings
# =================================
POSTGRES_PASSWORD=flyesports_dev_pass
DATABASE_URL=postgresql+asyncpg://flyesports:flyesports_dev_pass@localhost:5432/flyesports
DATABASE_ECHO=false

# =================================
# Redis Settings
# =================================
REDIS_PASSWORD=flyesports_redis_dev
REDIS_URL=redis://:flyesports_redis_dev@localhost:6379/0

# =================================
# JWT Settings
# =================================
JWT_SECRET_KEY=dev-jwt-secret-key-for-development-only-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# =================================
# Security Settings
# =================================
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# =================================
# Riot Games API Settings
# =================================
RIOT_API_KEY=
RIOT_API_BASE_URL=https://api.riotgames.com

# =================================
# Celery Settings
# =================================
CELERY_BROKER_URL=redis://:flyesports_redis_dev@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:flyesports_redis_dev@localhost:6379/1

# =================================
# Logging Settings
# =================================
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# =================================
# Frontend Settings (for docker-compose)
# =================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=FlyEsports
VITE_APP_ENV=development